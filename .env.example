# ─── KOMOE — Template d'environnement ────────────────────────────────────────
# Copier ce fichier en .env.local et remplir les valeurs réelles.
# Ce fichier est versionné (sans secrets). NE PAS y mettre de vraies clés.

# ════════════════════════════════════════════════════════════════════════════
# 🌐  VERCEL (Frontend Next.js) — Variables à configurer dans :
#     https://vercel.com/[votre-team]/komoe-miabe/settings/environment-variables
# ════════════════════════════════════════════════════════════════════════════

# ─── Backend URL ─────────────────────────────────────────────────────────────
# DEV  : http://127.0.0.1:8000
# PROD : https://komoe-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://komoe-backend.onrender.com

# ─── Blockchain / Polygon Amoy Testnet ───────────────────────────────────────
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...ADRESSE_BUDGETLEDGER_SUR_AMOY
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/VOTRE_CLE_ALCHEMY
NEXT_PUBLIC_REOWN_PROJECT_ID=VOTRE_REOWN_PROJECT_ID

# ─── IPFS / Pinata ───────────────────────────────────────────────────────────
NEXT_PUBLIC_PINATA_JWT=VOTRE_JWT_PINATA
NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud
PINATA_JWT=VOTRE_JWT_PINATA

# ─── MIA — Intelligence Artificielle ─────────────────────────────────────────
# ⚠️  SANS NEXT_PUBLIC_ = clés JAMAIS exposées au navigateur (côté serveur uniquement)
#
# DeepSeek (LLM principal pour le chat)
# → Créer sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Groq (LLM fallback + STT Whisper pour la voix)
# → Créer sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ════════════════════════════════════════════════════════════════════════════
# 🖥️  RENDER (Backend Django) — Variables à configurer dans :
#     https://dashboard.render.com/web/[service-id]/env
# ════════════════════════════════════════════════════════════════════════════

# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=votre_cle_secrete_hyper_robuste_ici
DEBUG=False
ALLOWED_HOSTS=komoe-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://komoe-miabe.vercel.app

# ─── Base de données (PostgreSQL Render) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/komoe

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Blockchain ──────────────────────────────────────────────────────────────
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/VOTRE_CLE_ALCHEMY
CONTRACT_ADDRESS=0x...ADRESSE_BUDGETLEDGER_SUR_AMOY
DEPLOYER_PRIVATE_KEY=0x...CLE_PRIVEE_DEPLOYER

# ─── IPFS / Pinata ───────────────────────────────────────────────────────────
PINATA_JWT=VOTRE_JWT_PINATA
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
